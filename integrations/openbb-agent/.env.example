# A language model maps each natural-language question onto one OptionsAhoy
# calculator and extracts its arguments. Set an OpenAI API key to run the agent
# locally. The financial math is computed by OptionsAhoy, not by the model.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the model used for tool selection (default gpt-4o).
# OPENAI_MODEL=gpt-4o

# Optional: point at a non-default OptionsAhoy base URL (default
# https://optionsahoy.com). OptionsAhoy's API is keyless; no API key is needed.
# OPTIONSAHOY_BASE_URL=https://optionsahoy.com
