{
  "name": "optionsahoy-mcp",
  "version": "1.10.2",
  "private": false,
  "description": "Equity-compensation optimizer. ISO/AMT, NSO, RSU, QSBS, single-stock concentration, protective puts/collars, and equity-funding plans. MCP server + REST API with federal + 50-state + DC tax code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "optionsahoy-mcp": "./dist/stdio-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlvisoOculus/optionsahoy-mcp.git"
  },
  "homepage": "https://optionsahoy.com/for-agents",
  "bugs": {
    "url": "https://github.com/AlvisoOculus/optionsahoy-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "vscode",
    "tax",
    "equity",
    "iso",
    "amt",
    "rsu",
    "nso",
    "qsbs",
    "options",
    "stock-options",
    "equity-compensation",
    "alternative-minimum-tax",
    "tax-optimization",
    "capital-gains",
    "section-1202",
    "concentration",
    "hedging",
    "protective-puts",
    "collar",
    "exercise",
    "vesting"
  ],
  "scripts": {
    "start": "tsx src/stdio-server.ts",
    "build": "esbuild src/stdio-server.ts --bundle --platform=node --target=node20 --outfile=dist/stdio-server.js --format=esm --banner:js='#!/usr/bin/env node' && chmod +x dist/stdio-server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:tax-tables": "node scripts/codegen/gen-federal-tax-tables.mjs",
    "verify:tax-tables": "node scripts/codegen/gen-federal-tax-tables.mjs --check",
    "gen:toolspec": "tsx scripts/codegen/gen-toolspec.mts",
    "verify:toolspec": "tsx scripts/codegen/gen-toolspec.mts --check",
    "gen:wellknown": "tsx scripts/codegen/stamp-wellknown-version.mts",
    "verify:wellknown": "tsx scripts/codegen/stamp-wellknown-version.mts --check",
    "verify:vols": "tsx scripts/verify-vols-artifact.mts",
    "verify:mcpb": "node scripts/verify-mcpb-freshness.mjs",
    "release:preflight": "npm run verify:toolspec && npm run verify:wellknown && npm run verify:mcpb && npm run verify:vols && node scripts/stdio-client-smoke.mjs",
    "gen:openapi": "tsx scripts/codegen/gen-openapi.mts",
    "verify:openapi": "tsx scripts/codegen/gen-openapi.mts --check",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run release:preflight",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "eval:routing": "tsx scripts/eval-routing.mts",
    "eval:discipline": "tsx scripts/eval-routing.mts --kinds input-discipline"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.3",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
